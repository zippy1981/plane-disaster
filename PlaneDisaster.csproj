<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PlaneDisaster</RootNamespace>
    <AssemblyName>PlaneDisaster</AssemblyName>
    <ApplicationIcon>PlaneDisaster.NET.ico</ApplicationIcon>
    <AssemblyOriginatorKeyFile>PlaneDisaster.snk</AssemblyOriginatorKeyFile>
    <!-- TargetFrameworkIdentifier isn't set yet while the project body evaluates, so derive it. -->
    <UseWindowsForms Condition=" $([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp' ">true</UseWindowsForms>
  </PropertyGroup>

  <!-- This project sits at the repo root, so keep the other projects and the installer out of its globs. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Jet2SQLite/**;jsql_admin/**;PlaneDisaster.Dba/**;UnitTests/**;PlaneDisaster.NET Setup/**;packages/**;WebSite/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFramework' ">
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PlaneDisaster.Dba\PlaneDisaster.Dba.csproj" />
  </ItemGroup>
</Project>
