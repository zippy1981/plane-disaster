<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>UnitTests</RootNamespace>
    <AssemblyName>UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- .NET Framework builds use NUnit 2.6, the last version for .NET 2.0; CI compiles these targets, the .NET 11 leg runs the tests. -->
  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFramework' ">
    <PackageReference Include="NUnit" Version="2.6.2" />
  </ItemGroup>

  <!-- .NET builds use NUnit 3, whose classic Assert API matches 2.6, run by dotnet test. -->
  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETCoreApp' ">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>

  <!-- Access databases from public sources for TestAccessSampleFiles; TestData\README.md lists them. -->
  <ItemGroup>
    <None Update="TestData\*.mdb;TestData\*.accdb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaneDisaster.Dba\PlaneDisaster.Dba.csproj" />
  </ItemGroup>
</Project>
