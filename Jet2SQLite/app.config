<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Run on CLR 2 when .NET 3.5 is installed, otherwise on CLR 4 (Windows 10 and later don't ship 3.5).
    The legacy activation policy lets CLR 4 load the mixed-mode System.Data.SQLite 1.0.66, built for CLR 2.
  -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v2.0.50727" />
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
