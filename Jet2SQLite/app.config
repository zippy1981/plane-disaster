<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Prefer CLR 4, which every supported Windows has, and fall back to CLR 2 for old machines with only
    .NET 2.0 to 3.5. CLR 4 comes first so a build targeting .NET Framework 4.8.1 never starts on CLR 2.
  -->
  <startup>
    <supportedRuntime version="v4.0" />
    <supportedRuntime version="v2.0.50727" />
  </startup>
</configuration>
