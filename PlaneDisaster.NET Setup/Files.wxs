<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- Program Files on x86, Program Files (not x86) on x64. -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLDIR" Name="PlaneDisaster.NET" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PlaneDisasterStartMenuFolder" Name="PlaneDisaster.NET" />
    </StandardDirectory>

    <ComponentGroup Id="PlaneDisasterComponents" Directory="INSTALLDIR">
      <Component Id="PlaneDisasterExe">
        <File Id="MainExecutable" Source="$(var.AppBin)PlaneDisaster.exe" KeyPath="yes" />
        <File Id="MainExecutableConfig" Source="$(var.AppBin)PlaneDisaster.exe.config" />

        <!-- File associations. MDE files are left to Access or the Access runtime. -->
        <ProgId Id="PlaneDisaster.mdbfile" Description="JetSQL Database" Icon="MainExecutable" IconIndex="0">
          <!-- The open verb is registered on the ProgId, so one extension carries it for both. -->
          <Extension Id="accdb">
            <Verb Id="open" TargetFile="MainExecutable" Argument="&quot;%1&quot;" />
          </Extension>
          <Extension Id="mdb" />
        </ProgId>
        <ProgId Id="PlaneDisaster.sqlitefile" Description="SQLite Database" Icon="MainExecutable" IconIndex="0">
          <Extension Id="sqlite">
            <Verb Id="open" TargetFile="MainExecutable" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
      </Component>

      <Component Id="PlaneDisasterDll">
        <File Id="PlaneDisaster.Dba" Source="$(var.AppBin)PlaneDisaster.Dba.dll" KeyPath="yes" />
        <!-- Version 0.92 called this PlaneDisaster.LIB.dll; remove it if an old install left it behind. -->
        <RemoveFile Id="PlaneDisasterLib" Name="PlaneDisaster.LIB.dll" On="install" />
      </Component>

      <Component Id="SQLite.NET">
        <File Id="SQLiteNet" Source="$(var.AppBin)System.Data.SQLite.DLL" KeyPath="yes" />
      </Component>

      <Component Id="Jet2SQLite">
        <File Id="Jet2SQLiteExecutable" Source="$(var.Jet2SQLiteBin)Jet2SQLite.exe" KeyPath="yes" />
        <File Id="Jet2SQLiteConfig" Source="$(var.Jet2SQLiteBin)Jet2SQLite.exe.config" />
      </Component>

      <Component Id="PlaneDisasterDocs">
        <File Id="LicenseFile" Source="license.rtf" KeyPath="yes" />
      </Component>

      <!-- Shortcuts live in the user's profile as far as ICE checks go, so they key off HKCU. -->
      <Component Id="StartMenuShortcuts" Directory="PlaneDisasterStartMenuFolder">
        <Shortcut Id="PlaneDisasterShortcut" Name="PlaneDisaster.NET" Target="[INSTALLDIR]PlaneDisaster.exe" WorkingDirectory="INSTALLDIR" />
        <Shortcut Id="Jet2SQLiteShortcut" Name="Jet2SQLite" Target="[INSTALLDIR]Jet2SQLite.exe" WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="RemovePlaneDisasterStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ZippySoft\PlaneDisaster.NET" Name="StartMenuShortcuts" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
