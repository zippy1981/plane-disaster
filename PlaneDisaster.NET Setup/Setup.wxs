<?xml version="1.0" encoding="utf-8"?>
<!-- The PlaneDisaster.NET installer. The UI is WiX's standard InstallDir wizard. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="PlaneDisaster.NET"
      Version="$(var.PlaneDisasterVersion)"
      Manufacturer="ZippySoft"
      UpgradeCode="AC7AACE6-D31E-4039-883C-3DC11D707B04"
      Language="1033"
      Codepage="1252"
      Scope="perMachine">
    <SummaryInformation Description="PlaneDisaster.NET $(var.PlaneDisasterVersion)" />

    <!-- Replaces every earlier version, including the WiX 2 MSIs that used the same upgrade code. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of PlaneDisaster.NET is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Launch
        Condition="Installed OR MsiNetAssemblySupport &gt;= &quot;2.0.50727&quot;"
        Message="This setup requires the .NET Framework 2.0 or higher." />

    <Icon Id="PlaneDisaster.ico" SourceFile="$(var.RepoRoot)PlaneDisaster.NET.ico" />
    <Property Id="ARPPRODUCTICON" Value="PlaneDisaster.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/zippy1981/plane-disaster" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <Feature Id="PlaneDisaster.NET" Title="PlaneDisaster.NET">
      <ComponentGroupRef Id="PlaneDisasterComponents" />
    </Feature>
  </Package>
</Wix>
